// Sipeed Tang Nano 20K, GW2AR-LV18QN88C8/I7.
// Board pins follow the standard 27 MHz clock, UART, LED, S1 bring-up map.
IO_LOC "clk27" 4;
IO_LOC "rst_n" 88;
IO_LOC "uart_rx_pin" 70;
IO_LOC "uart_tx_pin" 69;
IO_LOC "led" 15;

IO_PORT "clk27" IO_TYPE=LVCMOS33;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=UP;
